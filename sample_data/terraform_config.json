{
  "resource": {
    "aws_s3_bucket": {
      "secure_bucket": {
        "bucket": "my-secure-bucket",
        "acl": "private"
      }
    },
    "aws_security_group": {
      "secure_sg": {
        "name": "secure-security-group",
        "description": "Security group with restricted SSH",
        "ingress": [
          {
            "from_port": 22,
            "to_port": 22,
            "protocol": "tcp",
            "cidr_blocks": ["10.0.0.0/8"],
            "description": "SSH from internal network only"
          },
          {
            "from_port": 80,
            "to_port": 80,
            "protocol": "tcp",
            "cidr_blocks": ["0.0.0.0/0"],
            "description": "HTTP access"
          }
        ]
      }
    },
    "aws_instance": {
      "web_server": {
        "ami": "ami-0c55b159cbfafe1f0",
        "instance_type": "t2.micro",
        "security_groups": ["secure_sg"]
      }
    }
  }
}
