# Production Environment Configuration
ENVIRONMENT=production
DEBUG=false

# Application Settings
HOST=0.0.0.0
PORT=8000
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Security Settings
JWT_SECRET_KEY=your-super-secret-jwt-key-at-least-32-characters-long
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-admin-password
REDIS_PASSWORD=your-redis-password

# Rate Limiting
MAX_REQUESTS_PER_MINUTE=60
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# File Upload Settings
MAX_FILE_SIZE=100MB
ALLOWED_EXTENSIONS=.json,.hcl,.tf,.tfstate,.yml,.yaml

# Monitoring
METRICS_PORT=9090

# Database (if using external database)
# DATABASE_URL=postgresql://user:password@localhost:5432/driftdetector

# SSL Configuration
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Grafana
GRAFANA_PASSWORD=your-grafana-admin-password

# Cloud Provider Credentials (for optional integrations)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AZURE_CLIENT_ID=your-azure-client-id
# AZURE_CLIENT_SECRET=your-azure-client-secret
# AZURE_TENANT_ID=your-azure-tenant-id
# GCP_PROJECT_ID=your-gcp-project-id
# GCP_CREDENTIALS_PATH=/path/to/gcp-credentials.json
